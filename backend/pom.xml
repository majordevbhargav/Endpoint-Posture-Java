<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Was 3.5.7 - vulnerable to CVE-2026-22731 and CVE-2026-22733
             (actuator authentication-bypass, health-group / CloudFoundry
             endpoint paths). Both are fixed in 3.5.12. Bumping the parent
             BOM also lifts nearly every transitive dependency the Red Hat
             scan flagged (Tomcat/Jetty, Jackson, Netty, Spring Framework,
             Spring Security, Flyway) since they're all version-managed
             here. Check central.sonatype.com for anything newer than
             3.5.16 before building - Spring Boot ships patch releases
             roughly monthly. -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.endpointposture</groupId>
    <artifactId>endpoint-posture-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>endpoint-posture-java</name>
    <description>VE Compliance Engine - Spring Boot rewrite</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <!-- Was 2.8.6. Stay on the 2.8.x line - springdoc 3.x requires
             Spring Boot 4, which this project is not moving to yet. -->
        <springdoc.version>2.8.15</springdoc.version>
        <!-- Explicit main class - avoids Maven's auto-detection failing
             when target/ has stale artifacts or multiple candidate classes -->
        <start-class>com.endpointposture.EndpointPostureApplication</start-class>
    </properties>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JPA / Postgres -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <!-- Override the vulnerable version managed by the parent BOM. -->
            <version>42.7.12</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Security + JWT -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- API documentation: auto-generates a live Swagger UI from your
             @RestController classes and DTOs - no manual doc file to
             maintain, it stays in sync with the code automatically. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Explicit, not auto-detected - this is what fixes
                         "Unable to find a suitable main class" -->
                    <mainClass>com.endpointposture.EndpointPostureApplication</mainClass>
                    <!-- Forces the JVM's default timezone to UTC on every
                         `mvn spring-boot:run`, regardless of terminal/session
                         state. Fixes: FATAL: invalid value for parameter
                         "TimeZone": "Asia/Calcutta" - the JDBC driver reports
                         the JVM's OS-derived timezone at connection startup,
                         and some Windows locale setups report the older
                         "Asia/Calcutta" alias instead of the IANA-standard
                         "Asia/Kolkata" that Postgres actually recognizes.
                         Forcing UTC here sidesteps the mismatch entirely and
                         matches the timestamp convention used throughout
                         this project (all stored timestamps are UTC). -->
                    <jvmArguments>-Duser.timezone=UTC</jvmArguments>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Code-level documentation (Javadoc): run `mvn javadoc:javadoc`
                 any time to generate browsable HTML into target/site/apidocs/
                 from the /** ... */ comments you write on classes/methods.

                 Deliberately NOT bound to the "package" phase (no
                 <executions> block below) - it used to auto-run on every
                 `mvn package`/`verify`/`spring-boot:run`, and under a
                 non-LTS JDK build (JDK 22, 22+36-2370) its forked
                 javadoc.exe process crashed the JVM outright (hs_err_pid
                 crash dumps, C2 JIT compiler fault mid-compile on javac's
                 own JavaTokenizer::readToken) rather than reporting a
                 normal Maven error. Documentation generation is optional
                 and should never be able to block a build/run - invoke it
                 by hand with `mvn javadoc:javadoc` when you actually want
                 it, ideally under a proper JDK 21 LTS build rather than
                 JDK 22. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <doclint>none</doclint>
                    <show>protected</show>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>